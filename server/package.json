{
  "name": "@ledger/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "PORT=${PORT:-8090} tsx watch --clear-screen=false src/index.ts",
    "start": "node dist/index.js",
    "build": "esbuild src/index.ts src/cli.ts --bundle --platform=node --format=esm --target=node22 --outdir=dist --sourcemap --external:fastify --external:@fastify/* --external:postgres --external:exceljs --external:zod",
    "migrate": "tsx src/cli.ts migrate",
    "seed": "tsx src/cli.ts seed",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@fastify/jwt": "^9.1.0",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.1.1",
    "@ledger/shared": "*",
    "exceljs": "^4.4.0",
    "fastify": "^5.3.2",
    "postgres": "^3.4.5",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.25.4",
    "tsx": "^4.19.4",
    "typescript": "^5.9.3"
  }
}
